# S3-kit 連線設定範例。複製成 .env 後填入實際的值，連線到其他 S3 服務時只需要修改這裡。
# endpoint 使用 Docker 網路內的服務名稱與容器 port。
S3_ENDPOINT_URL=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=s3-kit
# 自架服務一定要填入金鑰。兩者都留空時會改用 boto3 預設的憑證來源（AWS IAM role、~/.aws 等）。
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# 預簽連結要給瀏覽器或外部服務時，填入外部連得到的位址；留空代表與 S3_ENDPOINT_URL 相同。
S3_PUBLIC_ENDPOINT_URL=

# 以下為選填，留空時使用 boto3 的預設值。
# 臨時憑證的 session token
S3_SESSION_TOKEN=
# 連線與讀取逾時秒數、最多嘗試次數（含第一次）
S3_CONNECT_TIMEOUT=
S3_READ_TIMEOUT=
S3_MAX_ATTEMPTS=
# 內部 CA 簽發的憑證；S3_VERIFY_SSL=false 只能用於本機或測試
S3_CA_BUNDLE=
S3_VERIFY_SSL=
